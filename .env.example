# Copy to .env.local for development. Production values live in your host's secret store.

WEFTLINE_PUBLIC_URL=http://localhost:3000

# Leave DATABASE_URL empty in development to use a local embedded database (.data/pglite).
# Production: a PostgreSQL 15+ connection string. DATABASE_URL_UNPOOLED is a direct connection
# used by migrations and the worker.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Set to the old key while rotating TOKEN_ENCRYPTION_KEY.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

RATE_LIMIT_PER_KEY=600
WEBHOOK_MAX_ATTEMPTS=10

# Development only: allow http:// and private-network webhook URLs.
ALLOW_PRIVATE_WEBHOOKS=false

# Optional: also send the webhook signature under this extra header name, for receivers
# written against older clients.
WEFTLINE_LEGACY_SIGNATURE_HEADER=

# Run the delivery worker inside the API process (default: only when using the embedded database).
WORKERS_IN_PROCESS=
