{
  "name": "weftline",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted unified API for email, calendar and contacts (v3 wire format)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "worker": "tsx src/worker.ts",
    "weftline": "tsx src/cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "nylas": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "bin": {
    "weftline": "dist/cli.js"
  }
}
